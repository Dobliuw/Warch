#!/usr/bin/env python3
"""Saca una paleta de warch de una imagen (para el esquema «Desde el wallpaper»).

Uso: warch-palette <imagen>   → imprime JSON con base, surface, surface2, fg, dim, accent, accent2.
Fondo: el tono dominante, muy oscuro y poco saturado. Acentos: los dos colores más vivos y frecuentes
con tonos bien distintos, llevados a una luminosidad legible sobre el fondo.
"""
import colorsys
import json
import sys

from PIL import Image


def hexc(h, l, s):
    r, g, b = colorsys.hls_to_rgb(h % 1.0, max(0, min(1, l)), max(0, min(1, s)))
    return "#%02x%02x%02x" % (round(r * 255), round(g * 255), round(b * 255))


def main():
    im = Image.open(sys.argv[1]).convert("RGB")
    im.thumbnail((240, 240))
    q = im.quantize(colors=16, method=Image.Quantize.MEDIANCUT)
    pal = q.getpalette()
    counts = sorted(q.getcolors(), reverse=True)
    total = sum(c for c, _ in counts)
    cols = []
    for count, idx in counts:
        r, g, b = (v / 255 for v in pal[idx * 3: idx * 3 + 3])
        h, l, s = colorsys.rgb_to_hls(r, g, b)
        cols.append({"w": count / total, "h": h, "l": l, "s": s})

    dom = cols[0]
    bh, bs = dom["h"], min(dom["s"], 0.3) * 0.6

    # Vivacidad: saturación con algo de luz, ponderada por presencia
    def vivid(c):
        return c["s"] * (1 - abs(c["l"] - 0.55)) * (0.35 + c["w"] ** 0.5)

    ranked = sorted(cols, key=vivid, reverse=True)
    a1 = ranked[0]
    a2 = next((c for c in ranked[1:] if min(abs(c["h"] - a1["h"]), 1 - abs(c["h"] - a1["h"])) > 0.11), ranked[1 % len(ranked)])

    def accent(c):
        return hexc(c["h"], 0.74, max(0.42, min(0.72, c["s"])))

    out = {
        "name": "Desde el wallpaper",
        "base": hexc(bh, 0.075, bs),
        "surface": hexc(bh, 0.11, bs),
        "surface2": hexc(bh, 0.165, bs),
        "fg": hexc(bh, 0.9, 0.12),
        "dim": hexc(bh, 0.62, 0.08),
        "accent": accent(a1),
        "accent2": accent(a2),
    }
    print(json.dumps(out))


if __name__ == "__main__":
    main()
